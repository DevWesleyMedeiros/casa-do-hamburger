generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  cep      String?
  password String?
  admin    Boolean @default(false)
  cartItem CartItem[] // cada usuário pode ter vários itens no carrinho
  orders Order[] // cada usuário pode ter vários pedidos
  passwordResetTokens PasswordResetToken[] // cada usuário pode ter vários tokens
  provider AuthProviders @default(LOCAL)
  googleId String? // duas constas não podem compartilhar o mesmo uid e nullable porque não tem esse campo preenchido contas via google
  firebaseUid String? @unique  // cada usuário do firebase tem um uid único

  emailVerifiedAt DateTime?
  emailVerified Boolean @default(false)
  emailVerificationTokens  EmailVerificationToken[]

// vão servir para logs do usuário
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deletedAt DateTime?
}
enum AuthProviders {
  LOCAL
  GOOGLE
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Products {
  id          String  @id @default(cuid())
  name        String
  description String
  price       Int
  category    String
  createAt    DateTime @default(now())
  images      ProductsImage[]
  cartItem    CartItem[]
  orderItems OrderItem[]
}

model ProductsImage {
  id String @id @default(cuid())
  url String
  key String
  mimeType String
  size Int
  isPrimary Boolean @default(true)
  productId String
  product Products @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model CartItem {
  id String @id @default(uuid())
  productId String
  userId String
  quantity Int @default(1)
  createdAt DateTime @default(now())
  product Products @relation(fields: [productId], references: [id])
  user User @relation(fields: [userId], references: [id])
  
  @@unique([userId, productId])
  @@index([userId])
}

model Order{
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  status OrderStatus @default(PENDING)
  total Int @default(0)
  items OrderItem[]
  payment Payment[] // 1:0..1 (RF-46, pagamento sempre simulado por ora)
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@index([userId])
  @@index([status]) // acelera listagem admin filtrada por status (US-07)
}

model OrderItem {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: orderId, references: [id], onDelete: Cascade)
  productId String? // opcional: mantém o item mesmo se o produto for apagado
  product Products? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // --- Snapshot Pattern (RN-ORDER-01/02/03) — nunca ler via JOIN ao vivo ---
  productName String  //snapshot para nome do produto no memento da compra
  productImageUrl String? //snapshot para url da imagem do produto no memento da compra (RF-33)
  unitPrice Int     // snapshot — preço unitário em centavos (RN-ORDER-04)
  quantity Int
  subtotal Int     // unitPrice * quantity, persistido (não recalculado on-the-fly)

  @@index([orderId])

}

// controle da máquina de estados do produto
enum OrderStatus {
  PENDING     // Pendente
  PREPARING   // Preparando
  READY   // Retirado
  CANCELLED   // Cancelado
  DELIVERED // Entregue ou retirado pelo cliente
}

// NOVO — RF-32/33/34 (Seção 6.9 da doc)
enum PaymentStatus {
  SIMULATED // único status usado na prática até implementarmos gateway de pagamento
  PENDING
  PAID
  FAILED
}

model Payment {
  id String @id @default(uuid())
  orderId String @unique
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status PaymentStatus @default(SIMULATED)
  gatewayProvider String? // null hoje; "stripe"/"mercadopago" no futuro (RF-46)
  gatewayId String? // null hoje; id do pagamento no gateway de pagamento

  createdAt DateTime @default(now())

}
model PasswordResetToken {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique // RN-AUTH-13: só o hash SHA-256, nunca o token cru
  expiresAt DateTime  // RN-AUTH-14: emitido com now() + 30min
  usedAt    DateTime? // RN-AUTH-14: marcado no consumo, garante uso único
  createdAt DateTime  @default(now())

  @@index([userId]) // consulta de tokens ativos para um usuário. Cria um índice de banco de dados na coluna userId. Na prática, isso acelera drasticamente a velocidade de busca e recuperação de registros quando você faz consultas filtrando pelo ID do usuário (como buscar todos os tokens ativos dele), evitando que o banco de dados precise varrer a tabela inteira.
  
  @@map("password_reset_tokens") // mapeamento de tabela no banco de dados. Define o nome real da tabela física no banco de dados como password_reset_tokens. Isso permite que você mantenha o padrão PascalCase e no singular no seu código TypeScript/Prisma (PasswordResetToken), enquanto a tabela no banco segue o padrão convencional snake_case e no plural, sem quebrar o mapeamento.
}

generator Client {
  provider = "prisma-client-js"
}
generator erd {
  provider = "prisma-erd-generator"
  output = "../docs/architecture/ERD.md"
  theme    = "forest"   // ou "default", "dark", "neutral"
}